# Токен бота от @BotFather. Никогда не коммитьте настоящий .env.
BOT_TOKEN=

# Telegram ID администраторов через запятую. Свой ID можно узнать, отправив боту /id.
ADMIN_IDS=

# Публичный контакт поддержки (без @). Это единственный контакт, который видят пользователи.
SUPPORT_USERNAME=s_sarvar

# Файл базы данных SQLite (относительно папки проекта).
DB_PATH=data/two_fit.db

# Плата за размещение объявления, сум. Продавец платит её сразу при создании анкеты (Click или Payme в Telegram).
LISTING_FEE=30000
# Токен платёжного провайдера: @BotFather → ваш бот → Payments → Click или Payme.
# Пусто — оплата выключена и объявления размещаются бесплатно.
PAYMENT_PROVIDER_TOKEN=
# Цена абонемента: 1 — считается автоматически (рекомендуемая по ценам 1Fit), 0 — продавец вводит сам.
AUTO_PRICE=1

# Скриншот абонемента при продаже: 1 — обязателен (видит только администратор), 0 — можно пропустить.
SCREENSHOT_REQUIRED=1

# Продажа промокодов 1Fit: 1 — включена, пусто или 0 — скрыта (по умолчанию скрыта).
PROMO_ENABLED=0
# Ставка комиссии за продажу промокода 1Fit (когда продажа включена).
PROMO_COMMISSION_PERCENT=30

# Сколько объявлений показывать на одной странице каталога.
PAGE_SIZE=5

# Мини-апп (Telegram Mini App). Публичный HTTPS-адрес, по которому открывается страница.
# Пусто — мини-апп выключен, бот работает как раньше.
WEBAPP_URL=

# Где бот слушает запросы мини-аппа. На этот адрес должен вести ваш HTTPS-прокси или туннель.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# Наблюдатель цен 1Fit: несколько раз в день читает цены 1Fit в Ташкенте и сообщает администраторам,
# если они изменились (обновляются кнопкой, сами не меняются). 0 — выключить.
FIT_WATCH=1
# Время проверок по Ташкенту, через запятую.
FIT_WATCH_TIMES=08:00,11:00,14:00,17:00,20:00
# Адрес API 1Fit с ценами для Ташкента (city_id=1). Менять только если 1Fit его поменял.
FIT_API_URL=https://api-uz.1fit.app/api/landing/v2/subscriptions/?city_id=1
