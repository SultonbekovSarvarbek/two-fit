# Токен бота от @BotFather. Никогда не коммитьте настоящий .env.
BOT_TOKEN=

# Telegram ID администраторов через запятую. Свой ID можно узнать, отправив боту /id.
ADMIN_IDS=

# Публичный контакт поддержки (без @). Это единственный контакт, который видят пользователи.
SUPPORT_USERNAME=s_sarvar

# Файл базы данных SQLite (относительно папки проекта).
DB_PATH=data/two_fit.db

# Ставка комиссии Two Fit в процентах (с продавца, только после успешной продажи).
COMMISSION_PERCENT=10

# Сколько объявлений показывать на одной странице каталога.
PAGE_SIZE=5

# Мини-апп (Telegram Mini App). Публичный HTTPS-адрес, по которому открывается страница.
# Пусто — мини-апп выключен, бот работает как раньше.
WEBAPP_URL=

# Где бот слушает запросы мини-аппа. На этот адрес должен вести ваш HTTPS-прокси или туннель.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
